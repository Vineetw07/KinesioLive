{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true
  },
  "files": [],
  "references": [
    { "path": "./shared" },
    { "path": "./server" },
    { "path": "./client" }
  ],
  "exclude": ["node_modules", "dist", "tests", "client/dist", "server/dist", "shared/dist"]
}
