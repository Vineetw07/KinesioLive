{
  "name": "@kinesio/client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean:src": "node -e \"const fs=require('fs'), path=require('path'); const s=path.resolve('src'); if(fs.existsSync(s)){fs.readdirSync(s).filter(f=>f.endsWith('.js')||f.endsWith('.d.ts')).forEach(f=>fs.unlinkSync(path.join(s,f)));}\"",
    "prebuild": "pnpm run clean:src",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cometchat/calls-sdk-javascript": "^5.0.5",
    "@cometchat/chat-sdk-javascript": "^4.1.13",
    "@kinesio/shared": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.14",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
